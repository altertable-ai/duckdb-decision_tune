# name: test/sql/model_store_download.test
# description: downloading through decide_onnx_model_url verifies the file and leaves no partial file
# group: [sql]

require decide_onnx

require-env DECIDE_ONNX_MODEL_PATH

# A local directory works as the base URL too
statement ok
SET GLOBAL decide_onnx_model_url = '{DECIDE_ONNX_MODEL_PATH}';

statement ok
SET GLOBAL decide_onnx_cache_dir = '{TEST_DIR}/download_cache';

query I
SELECT cached FROM decide_onnx_models() WHERE file_name = 'tokenizer.json';
----
false

# Concurrent connections race to download and load the same tokenizer.
concurrentloop connection 0 8

query I
SELECT decide_onnx_tokenize('The order arrived broken.');
----
[504, 1686, 6612, 6792, 30]

endloop

query I
SELECT cached FROM decide_onnx_models() WHERE file_name = 'tokenizer.json';
----
true

query I
SELECT count(*) FROM glob('{TEST_DIR}/download_cache/*.tmp*');
----
0

query I
SELECT count(*) FROM glob('{TEST_DIR}/download_cache/tokenizer.json.verified');
----
1
