# name: test/sql/parity_tokenizer.test
# description: decide_onnx_tokenize matches the vela3-fast tokenizer of the reference (test/data/parity/tokenizer.csv)
# group: [sql]

require decide_onnx

require-env DECIDE_ONNX_MODEL_PATH

statement ok
SET decide_onnx_model_path = '{DECIDE_ONNX_MODEL_PATH}';

statement ok
CREATE TABLE cases AS
SELECT case_id::INTEGER AS case_id, coalesce(text, '') AS text, ids
FROM read_csv('test/data/parity/tokenizer.csv', header = true, all_varchar = true, quote = '"', escape = '"');

query I
SELECT count(*) FROM cases;
----
394

query III
SELECT case_id, text, ids FROM cases WHERE decide_onnx_tokenize(text)::VARCHAR <> ids ORDER BY case_id;
----
